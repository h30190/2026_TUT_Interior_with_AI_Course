<Project Sdk="Microsoft.NET.Sdk">
  <!-- Revit 2024 外掛（.NET Framework 4.8）。在 Windows 用 Visual Studio 2022 開啟，或命令列 dotnet build -c Release -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>TileSettingOutExport</AssemblyName>
    <RootNamespace>TileSettingOut</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <!-- Revit API 只拿來編譯，執行時用 Revit 自己的，不要複製進輸出資料夾 -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.60" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <None Update="TileSettingOut.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

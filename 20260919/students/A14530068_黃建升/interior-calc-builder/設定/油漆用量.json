{
  "檔名": "油漆用量計算機.html",
  "標題": "油漆用量計算機",
  "說明": "輸入空間坪數與淨高，估算乳膠漆需要幾加侖。南應室設 115-1 第一堂產出。",
  "公式": "油漆",
  "輸入": [
    { "id": "ping", "標籤": "地坪（坪）", "說明": "要粉刷的那個空間的地板面積", "預設": 10, "step": 0.5 },
    { "id": "wallH", "標籤": "牆面淨高（公尺）", "說明": "地板到天花板，不是樓層高", "預設": 2.8, "step": 0.1 },
    { "id": "perim", "標籤": "牆面周長（公尺）", "說明": "四面牆長度相加。填 0 則由坪數推估，見下方假設", "預設": 0, "step": 0.1 },
    { "id": "openArea", "標籤": "門窗開口面積（m²）", "說明": "門、窗、櫃體等不粉刷的面積合計", "預設": 6, "step": 0.5 }
  ],
  "參數": [
    { "id": "rate", "標籤": "每公升塗佈面積（m²／道）", "說明": "⚠ 預設 9。實際看漆罐標示，常見 8–12", "預設": 9, "step": 0.5, "min": 0.1 },
    { "id": "coats", "標籤": "塗刷道數", "說明": "面漆兩道為常規；深色蓋淺色可能要 3 道", "預設": 2, "step": 1, "min": 1 },
    { "id": "loss", "標籤": "損耗率（%）", "說明": "⚠ 預設 10。含刷具吸收、修補、調色備量", "預設": 10, "step": 1 }
  ],
  "結果": { "欄位": "加侖數", "單位": "加侖" },
  "次要結果": "（需求 {公升} L，1 加侖 = 3.785 L）",
  "免責": "此為估算值，不是下單量。深色跳色、批土重刷、特殊底材都會改變用量，下單前請以現場複丈與漆廠標示確認。",
  "驗算": [
    {
      "標題": "10 坪、淨高 2.8、扣 6 m²、由坪數推估",
      "輸入": { "ping": 10, "wallH": 2.8, "perim": 0, "openArea": 6, "rate": 9, "coats": 2, "loss": 10 },
      "預期": { "公升": 14.27, "加侖數": 4 }
    },
    {
      "標題": "實測周長 20 m、淨高 2.8、扣 6 m²",
      "輸入": { "ping": 10, "wallH": 2.8, "perim": 20, "openArea": 6, "rate": 9, "coats": 2, "loss": 10 },
      "預期": { "公升": 12.22, "加侖數": 4 }
    }
  ]
}
